# Copie este arquivo para ".env" (uso local) e/ou configure as mesmas
# variáveis no painel da Vercel (Project Settings -> Environment Variables)
# antes do deploy.

# Domínio da base de conhecimento, usado no prompt do sistema.
KNOWLEDGE_DOMAIN="jogos eletrônicos (games)"

# Provedor da LLM externa usada apenas na etapa de geração da resposta.
# Opções suportadas: groq | openai | deepseek | nvidia | huggingface | gemini
LLM_PROVIDER=groq

# Chave de API do provedor escolhido.
LLM_API_KEY=coloque_sua_chave_aqui

# Modelo a usar (opcional — cada provedor já tem um modelo padrão razoável
# definido em app/config.py). Exemplos:
#   groq:        llama-3.3-70b-versatile / llama-3.1-8b-instant
#   openai:      gpt-4o-mini
#   deepseek:    deepseek-chat
#   nvidia:      meta/llama-3.1-8b-instruct
#   huggingface: meta-llama/Llama-3.1-8B-Instruct
#   gemini:      gemini-1.5-flash
LLM_MODEL=

# Só use se precisar apontar para uma URL de API diferente do padrão.
LLM_BASE_URL=

LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.3

# Quantos chunks recuperar do índice vetorial por pergunta.
TOP_K=4
# Quantas mensagens anteriores do chat entram no prompt como memória curta.
MAX_HISTORY_MESSAGES=6
